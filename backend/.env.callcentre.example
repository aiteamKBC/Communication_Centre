# Call Centre settings (callcentre app). Copy the names into backend/.env; never commit values.
# Call-centre tables live in the login database (login_DATABASE_URL); no separate URL is needed.

# Read-only Aptem source (same database the legacy dashboard used as APPTEM_DATABASE_URL).
CALLCENTRE_APTEM_DATABASE_URL=

# Read-only LMS database (the LMS backend's DATABASE_URL): master learner list, merged with Aptem, and the
# coaches' booking pages (LMS admin -> Coach directory; a director links each coach to their page).
CALLCENTRE_LMS_DATABASE_URL=

# Zoom Phone Server-to-Server OAuth apps, one per account.
ZOOM_STUDENT_ACCOUNT_ID=
ZOOM_STUDENT_CLIENT_ID=
ZOOM_STUDENT_CLIENT_SECRET=
ZOOM_OFFICE_ACCOUNT_ID=
ZOOM_OFFICE_CLIENT_ID=
ZOOM_OFFICE_CLIENT_SECRET=
ZOOM_REPORT_TIME_ZONE=Europe/London

# true: the Call button dials in the Zoom phone docked in the Engagement Centre (Zoom Phone Smart Embed).
# Needs the Smart Embed app installed by the Zoom admin. Off: the Zoom desktop app is opened.
CALLCENTRE_SMART_EMBED=

# KBC technical support (help-desk) site, e.g. https://technicalsupport.kentbusinesscollege.net. Specialists raise a
# learner's technical issue there as a ticket, and the worker follows its status. Empty = switched off.
CALLCENTRE_HELPDESK_URL=

# The test learner: a phone you can answer (e.g. your mobile) puts one always-first missed-lecture case on the
# list that comes back as new after it is worked. Local testing only; leave empty in production. Empty = removed.
CALLCENTRE_TEST_LEARNER_PHONE=
# Optional: a mailbox you can read for the test learner (default: a non-deliverable address).
CALLCENTRE_TEST_LEARNER_EMAIL=

# OpenAI: transcription fallback (ZOOM_AI_*) and transcript analysis (CALLCENTRE_AI_ENABLED).
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TRANSCRIPTION_MODEL=
ZOOM_AI_TRANSCRIPTION_ENABLED=false
ZOOM_AI_TRANSCRIPTS_PER_SYNC=10
CALLCENTRE_AI_ENABLED=false

# Email: dry_run records emails without sending; live sends them through Microsoft 365 (mailer.py).
# The director's Settings tab (database) overrides these defaults.
CALLCENTRE_EMAIL_MODE=dry_run
CALLCENTRE_EMAIL_DAILY_CAP=2
# true on the production server ONLY. Without it this server records emails and never sends them,
# whatever the shared Settings tab says (local and test copies use the same database).
CALLCENTRE_EMAIL_LIVE_ALLOWED=
# No-reply sending app (Microsoft Graph, Mail.Send on the sender mailbox).
CALLCENTRE_MAIL_TENANT_ID=
CALLCENTRE_MAIL_CLIENT_ID=
CALLCENTRE_MAIL_CLIENT_SECRET=
CALLCENTRE_MAIL_SENDER=
# Automatic reminders (defaults until a director saves the Settings tab).
CALLCENTRE_REMINDERS_ENABLED=
CALLCENTRE_REMINDER_DAYS=
CALLCENTRE_REMINDER_ESCALATE_DAY=
# Internal copy for line-manager escalations and low scores (low-score emails are blocked without it).
CALLCENTRE_ESCALATION_EMAIL=
# Public https origin of the backend, e.g. https://cc.example.org (links in emails fail closed without it).
CALLCENTRE_PUBLIC_URL=
# Comma-separated YYYY-MM-DD dates excluded from SLA working days.
CALLCENTRE_HOLIDAYS=

# Learner satisfaction: Active, Delivery and Onboarding, LMS status first, Aptem fallback.
# Only confirmed test identities are excluded; guessed test names are never excluded automatically.
# Format: lms:123,aptem:456,email:demo@example.test
CALLCENTRE_CONFIRMED_TEST_IDENTIFIERS=
# Satisfaction email button prepares a draft only. Azure delivery is not connected yet;
# learner satisfaction emails never go through the legacy n8n reminder pipeline.

# Comma-separated origins allowed to POST with the session cookie (default: the Vite dev server on :3000).
# Production must list its public origin, e.g. https://cc.example.org
CSRF_TRUSTED_ORIGINS=
# true when a proxy in front of Django ends HTTPS and sets X-Forwarded-Proto (otherwise CSRF refuses https POSTs).
DJANGO_BEHIND_HTTPS_PROXY=
