# Configure this separately in the deployed backend environment. The local .env
# is ignored by Git and is not included in a frontend build or repository push.
# Replace placeholders using your secret settings; never commit real credentials.
TRAINING_PLAN_LMS_REFERENCE_DATABASE_URL=postgresql://LMS_READER:PASSWORD@LMS_HOST:5432/LMS_DATABASE?sslmode=require

# The dedicated reader needs USAGE on schema curriculum and SELECT on:
#   curriculum.modules
#   curriculum.england_holidays
# It must have no INSERT, UPDATE, DELETE or TRUNCATE permissions on these tables.
# Restart every backend worker after setting/changing the environment variable.
# Then run from backend: python manage.py check_lms_reference_source
